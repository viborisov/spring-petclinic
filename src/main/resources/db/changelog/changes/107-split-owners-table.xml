<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

	<changeSet id="107-1-create-owners-table" author="Viktor">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="owners_basic"/>
			</not>
		</preConditions>

		<createTable tableName="owners_basic">
			<column name="id" type="INT" autoIncrement="true">
				<constraints primaryKey="true" primaryKeyName="pk_owners_basic" nullable="false"/>
			</column>
			<column name="first_name" type="VARCHAR(30)">
				<constraints nullable="false"/>
			</column>
			<column name="last_name" type="VARCHAR(30)">
				<constraints nullable="false"/>
			</column>
		</createTable>

		<rollback>
			<dropTable tableName="owners_basic"/>
		</rollback>
	</changeSet>

	<changeSet id="107-2-create-owners_contact" author="Viktor">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="owners_contact"/>
			</not>
		</preConditions>

		<createTable tableName="owners_contact">
			<column name="owner_id" type="INT">
				<constraints primaryKey="true" primaryKeyName="pk_owners_contact" nullable="false"/>
			</column>
			<column name="address" type="VARCHAR(255)"/>
			<column name="city" type="VARCHAR(80)"/>
			<column name="telephone" type="VARCHAR(20)"/>
			<column name="email" type="VARCHAR(255)"/>
		</createTable>

		<addForeignKeyConstraint baseTableName="owners_contact"
								 baseColumnNames="owner_id"
								 constraintName="fk_owners_owners_contact"
								 referencedTableName="owners_basic"
								 referencedColumnNames="id"/>

		<rollback>
			<dropForeignKeyConstraint baseTableName="owners_contact"
									  constraintName="fk_owners_owners_contact"/>
			<dropTable tableName="owners_contact"/>
		</rollback>
	</changeSet>

	<changeSet id="107-3-copy-owners-basic-data" author="Viktor">
		<preConditions onFail="HALT" onError="HALT">
			<tableExists tableName="owners"/>
			<tableExists tableName="owners_basic"/>
			<sqlCheck expectedResult="0">
				SELECT COUNT(*) FROM owners_basic
			</sqlCheck>
		</preConditions>

		<sql>
			INSERT INTO owners_basic (id, first_name, last_name)
			SELECT id, first_name, last_name
			from owners;
		</sql>

		<rollback>
			<sql>
				DELETE FROM owners_basic
			</sql>
		</rollback>
	</changeSet>

	<changeSet id="107-4-copy-owners-contact-data" author="Viktor">
		<preConditions onFail="HALT" onError="HALT">
			<tableExists tableName="owners"/>
			<tableExists tableName="owners_contact"/>
			<sqlCheck expectedResult="0">
				SELECT COUNT(*) FROM owners_contact;
			</sqlCheck>
		</preConditions>

		<sql>
			INSERT INTO owners_contact (owner_id, address, city, telephone, email)
			SELECT id, address, city, telephone, NULL
			from owners;
		</sql>

		<rollback>
			<sql>
				DELETE FROM owners_contact;
			</sql>
		</rollback>
	</changeSet>

	<changeSet id="107-5-switch-pets-fk" author="Viktor">
		<preConditions onFail="HALT">
			<tableExists tableName="pets"/>
			<tableExists tableName="owners_basic"/>
			<foreignKeyConstraintExists foreignKeyName="fk_pets_owners"/>
		</preConditions>

		<dropForeignKeyConstraint baseTableName="pets"
								  constraintName="fk_pets_owners"/>

		<addForeignKeyConstraint baseTableName="pets"
								 baseColumnNames="owner_id"
								 constraintName="fk_pets_owners_basic"
								 referencedTableName="owners_basic"
								 referencedColumnNames="id"/>

		<rollback>
			<dropForeignKeyConstraint baseTableName="pets"
									  constraintName="fk_pets_owners_basic"/>

			<addForeignKeyConstraint baseTableName="pets"
									 baseColumnNames="owner_id"
									 constraintName="fk_pets_owners"
									 referencedTableName="owners"
									 referencedColumnNames="id"/>
		</rollback>
	</changeSet>

	<changeSet id="107-6-drop-old-owners" author="Viktor">
		<preConditions onFail="HALT">
			<tableExists tableName="owners"/>
			<tableExists tableName="owners_basic"/>
			<tableExists tableName="owners_contact"/>
		</preConditions>

		<dropTable tableName="owners"/>

		<rollback>
			<createTable tableName="owners">
				<column name="id" type="INT" autoIncrement="true">
					<constraints primaryKey="true" primaryKeyName="pk_owners" nullable="false"/>
				</column>
				<column name="first_name" type="VARCHAR(30)">
					<constraints nullable="false"/>
				</column>
				<column name="last_name" type="VARCHAR(30)">
					<constraints nullable="false"/>
				</column>
				<column name="address" type="VARCHAR(255)">
					<constraints nullable="false"/>
				</column>
				<column name="city" type="VARCHAR(80)">
					<constraints nullable="false"/>
				</column>
				<column name="telephone" type="VARCHAR(20)">
					<constraints nullable="false"/>
				</column>
			</createTable>

			<sql>
				INSERT INTO owners (id, first_name, last_name, address, city, telephone)
				SELECT ob.id, ob.first_name, ob.last_name, oc.address, oc.city, oc.telephone
				FROM owners_basic ob
				JOIN owners_contact oc ON oc.owner_id = ob.id;
			</sql>
		</rollback>
	</changeSet>
</databaseChangeLog>
