<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

	<changeSet id="020-create-index-visits-pet-id" author="Viktor">
		<createIndex tableName="visits" indexName="visits_pet_id">
			<column name="pet_id"/>
		</createIndex>
	</changeSet>

	<changeSet id="021-create-index-pets_name" author="Viktor">
		<createIndex tableName="pets" indexName="pets_name">
			<column name="name"/>
		</createIndex>
	</changeSet>

	<changeSet id="022-create-index-owners_last_name" author="Viktor">
		<createIndex tableName="owners" indexName="owners_last_name">
			<column name="last_name"/>
		</createIndex>
	</changeSet>

	<changeSet id="023-create-index-types_name" author="Viktor">
		<createIndex tableName="types" indexName="types_name">
			<column name="name"/>
		</createIndex>
	</changeSet>

	<changeSet id="024-create-index-specialties_name" author="Viktor">
		<createIndex tableName="specialties" indexName="specialties_name">
			<column name="name"/>
		</createIndex>
	</changeSet>

	<changeSet id="025-create-index-vets_last_name" author="Viktor">
		<createIndex tableName="vets" indexName="vets_last_name">
			<column name="last_name"/>
		</createIndex>
	</changeSet>

</databaseChangeLog>
